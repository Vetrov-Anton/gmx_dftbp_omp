Bootstrap: docker
From: ubuntu:24.04

# ---------------------------------------------------------------------------
# GROMACS (this tree: Kubar's DFTB+ QM/MM with the one-rank OpenMP work) + DFTB+ + PLUMED,
# all on Intel MKL, for Intel and AMD CPUs. Build with build.sh next to this file:
#
#   ./build.sh                       gmx-dftbplus-mkl.sif     # CPU vendor detected at run time
#   ./build.sh auto gmx.sif --build-arg GMX_SIMD=AVX_512        # any argument below
#
# MKL takes its fast (AVX2/AVX-512) paths only on CPUs it identifies as Intel
# (mkl_serv_intel_cpu_true(); MKL_DEBUG_CPU_TYPE has no effect since MKL 2020.1). libmklfix.so
# (mklfix.c) defines that function and is made a DT_NEEDED of gmx and dftb+, ahead of MKL in the
# symbol lookup order, so no LD_PRELOAD is needed. CPU_VENDOR:
#   auto   (default) the vendor is read with CPUID when the program runs: 1 on AMD, MKL's own
#          answer on Intel. The same image is right on both; MKL_VENDOR_OVERRIDE=off|on at run
#          time switches the override off or forces it.
#   amd    always 1 (as auto on an AMD CPU).
#   intel  no override library at all.
# On 600 QM atoms, 8 threads of a Threadripper 3990X: 3474 -> 2495 ms/step with the override.
#
# GMX_SIMD: auto = detected by GROMACS on the build host (written to /opt/build_config.txt);
# set it (AVX2_256, AVX_512, ...) when the image is built on another machine than the one
# it runs on.
#
# One LAPACK per process: GROMACS uses MKL as its external BLAS/LAPACK too. With OpenBLAS in
# libgromacs the LAPACK calls of DFTB+ go to OpenBLAS; with the internal LAPACK of GROMACS
# they go to that incomplete copy (segfault in dlaswp_). Both are checked below.
# ---------------------------------------------------------------------------

%arguments
    CPU_VENDOR=auto
    GMX_SIMD=auto
    NJOBS=8
    DFTBPLUS_VERSION=25.1
    PLUMED_COMMIT=53a1773
    PLUMED_PATCH=gromacs-2026.0
    LIBTORCH_URL=https://download.pytorch.org/libtorch/cpu/libtorch-cxx11-abi-shared-with-deps-2.2.0%2Bcpu.zip
    SRC_TARBALL=gromacs-src.tar.gz

%files
    {{ SRC_TARBALL }} /opt/src/gromacs-src.tar.gz
    mklfix.c /opt/mklfix/mklfix.c

%environment
    export PATH=/opt/gmx/bin:/opt/plumed/bin:/opt/dftbplus/bin:${PATH}
    export LD_LIBRARY_PATH=/opt/gmx/lib:/opt/plumed/lib:/opt/libtorch/lib:/opt/dftbplus/lib:${LD_LIBRARY_PATH}
    export PLUMED_KERNEL=/opt/plumed/lib/libplumedKernel.so
    unset OMP_NUM_THREADS
    # The QM/MM report files (qmmm_topology_report.txt of grompp, qmmm_redistribution_report.txt of mdrun)
    # are off by default in the image; apptainer exec --env GMX_QMMM_REPORTS=on (or APPTAINERENV_GMX_QMMM_REPORTS=on,
    # or "env GMX_QMMM_REPORTS=on gmx ..." inside the container) switches them on. A plain host variable is not passed.
    export GMX_QMMM_REPORTS=${GMX_QMMM_REPORTS:-off}

%post -c /bin/bash
    set -e -x
    export DEBIAN_FRONTEND=noninteractive
    CPU_VENDOR={{ CPU_VENDOR }}
    GMX_SIMD={{ GMX_SIMD }}
    NJOBS={{ NJOBS }}
    case ${CPU_VENDOR} in
        auto|amd|intel) ;;
        *) echo "ERROR: CPU_VENDOR must be auto, amd or intel, not '${CPU_VENDOR}'"; exit 1 ;;
    esac
    [ ${GMX_SIMD} = auto ] && GMX_SIMD=AUTO
    M=/usr/lib/x86_64-linux-gnu

    # ------------------------- toolchain and MKL ------------------------------
    apt-get update -y
    echo "libmkl-rt libmkl-rt/use-as-default-blas-lapack boolean false" | debconf-set-selections
    apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
        ca-certificates wget git unzip xxd patch file patchelf binutils \
        build-essential gfortran cmake ninja-build \
        libfftw3-dev libgsl-dev zlib1g-dev libopenmpi-dev openmpi-bin \
        python3 python3-dev python3-numpy hwloc numactl vim less \
        libmkl-dev libmkl-gnu-thread libmkl-gf-lp64 libmkl-core libmkl-avx2 libmkl-avx512 libmkl-def
    GOMP=$(gfortran -print-file-name=libgomp.so)
    MKLLIBS="${M}/libmkl_gf_lp64.so;${M}/libmkl_gnu_thread.so;${M}/libmkl_core.so;${GOMP};${M}/libm.so"

    # ------------------------- DFTB+ on MKL -> /opt/dftbplus -------------------
    mkdir -p /opt/src && cd /opt/src && rm -rf dftbplus
    git clone --recursive --depth 1 -b {{ DFTBPLUS_VERSION }} https://github.com/dftbplus/dftbplus.git
    cd dftbplus
    cmake -B _build -G Ninja -DCMAKE_INSTALL_PREFIX=/opt/dftbplus -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON -DWITH_API=ON -DENABLE_DYNAMIC_LOADING=ON \
        -DWITH_TBLITE=ON -DWITH_SDFTD3=ON -DWITH_MPI=OFF -DWITH_OMP=ON -DWITH_PYTHON=OFF \
        -DBUILD_TESTING=OFF -DBLAS_LIBRARY="${MKLLIBS}" -DLAPACK_LIBRARY="${MKLLIBS}" \
        -DHYBRID_CONFIG_METHODS="Submodule;Find;Fetch"
    cmake --build _build -- -j${NJOBS}
    cmake --install _build
    cd /opt/src && rm -rf dftbplus

    # ------------------------- libtorch, PLUMED -> /opt/plumed ------------------
    cd /tmp && wget -q -O libtorch.zip "{{ LIBTORCH_URL }}"
    cd /opt && unzip -q /tmp/libtorch.zip && rm -f /tmp/libtorch.zip
    cd /tmp && rm -rf plumed2
    git clone -b v2.10 https://github.com/plumed/plumed2.git plumed2
    cd plumed2 && git checkout {{ PLUMED_COMMIT }}
    export CPATH=${CPATH:-}:/opt/libtorch/include/torch/csrc/api/include:/opt/libtorch/include
    export LIBRARY_PATH=${LIBRARY_PATH:-}:/opt/libtorch/lib
    export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}:/opt/libtorch/lib
    ./configure --prefix=/opt/plumed --enable-modules=all --enable-libtorch CC=mpicc CXX=mpicxx
    make -j ${NJOBS} && make install
    cd /tmp && rm -rf plumed2

    # ------------------------- GROMACS on MKL -> /opt/gmx ----------------------
    export PATH=/opt/plumed/bin:${PATH}
    export LD_LIBRARY_PATH=/opt/plumed/lib:/opt/dftbplus/lib:${LD_LIBRARY_PATH}
    cd /opt/src && mkdir gromacs && tar xzf gromacs-src.tar.gz -C gromacs --strip-components=1
    cd gromacs
    plumed --no-mpi patch -p -e {{ PLUMED_PATCH }}
    if find . -name "*.rej" | grep -q . ; then echo "ERROR: rejected plumed hunks"; exit 1; fi
    cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/opt/gmx -DCMAKE_BUILD_TYPE=Release \
        -DGMX_DOUBLE=ON -DGMX_MPI=ON -DGMX_OPENMP=ON -DGMX_GPU=OFF -DGMX_DEFAULT_SUFFIX=OFF \
        -DGMX_SIMD=${GMX_SIMD} -DGMX_FFT_LIBRARY=fftw3 -DGMX_BUILD_OWN_FFTW=OFF \
        -DGMX_EXTERNAL_BLAS=ON -DGMX_EXTERNAL_LAPACK=ON \
        -DGMX_BLAS_USER="${MKLLIBS}" -DGMX_LAPACK_USER="${MKLLIBS}" \
        -DGMXAPI=OFF -DGMX_INSTALL_NBLIB_API=OFF \
        -DGMX_BUILD_MANUAL=OFF -DBUILD_TESTING=OFF -DGMX_BUILD_UNITTESTS=OFF \
        -DGMX_USE_PLUMED=ON -DGMX_QMMM_PROGRAM=dftbplus -DGMX_QMMM_DFTBPLUS_LIB=/opt/dftbplus
    cmake --build build -j ${NJOBS}
    cmake --install build
    # GMX_SIMD=AUTO stays AUTO in the cache; the SIMD chosen is kept in *_PREVIOUS_VALUE
    SIMD_USED=$(grep -E "^GMX_SIMD_ACTIVE_PREVIOUS_VALUE:" build/CMakeCache.txt | cut -d= -f2)
    BUILD_HOST_CPU=$(grep -m1 "^model name" /proc/cpuinfo | cut -d: -f2- | sed 's/^ *//')
    printf "CPU_VENDOR=%s\nGMX_SIMD=%s\nbuild host CPU=%s\n" "${CPU_VENDOR}" "${SIMD_USED:-unknown}" "${BUILD_HOST_CPU:-unknown}" > /opt/build_config.txt
    cd /opt/src && rm -rf gromacs gromacs-src.tar.gz
    export LD_LIBRARY_PATH=/opt/gmx/lib:${LD_LIBRARY_PATH}
    if ldd /opt/gmx/bin/gmx | grep -q openblas; then echo "ERROR: OpenBLAS loaded by gmx"; exit 1; fi
    if nm -D --defined-only /opt/gmx/lib/libgromacs.so | grep -qw dgetrs_; then echo "ERROR: libgromacs exports its own LAPACK"; exit 1; fi

    # ------------------------- MKL vendor check -------------------------------
    if [ ${CPU_VENDOR} != intel ]; then
        FIXFLAGS=""; [ ${CPU_VENDOR} = amd ] && FIXFLAGS="-DMKLFIX_ALWAYS"
        gcc -shared -fPIC -O2 ${FIXFLAGS} -o /opt/mklfix/libmklfix.so /opt/mklfix/mklfix.c -ldl
        for exe in /opt/gmx/bin/gmx /opt/dftbplus/bin/dftb+; do
            patchelf --add-needed /opt/mklfix/libmklfix.so ${exe}
            readelf -d ${exe} | grep -q libmklfix
        done
    fi

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%test
    export LD_LIBRARY_PATH=/opt/gmx/lib:/opt/plumed/lib:/opt/libtorch/lib:/opt/dftbplus/lib:${LD_LIBRARY_PATH:-}
    cat /opt/build_config.txt
    ldd /opt/gmx/bin/gmx | grep -E "mkl|openblas|dftbplus"
    ! ldd /opt/gmx/bin/gmx | grep -q openblas && echo "OK: MKL is the only BLAS/LAPACK"
    if ! grep -q "CPU_VENDOR=intel" /opt/build_config.txt; then
        readelf -d /opt/gmx/bin/gmx | grep -q libmklfix && echo "OK: MKL vendor check override linked"
    else
        ! readelf -d /opt/gmx/bin/gmx | grep -q libmklfix && echo "OK: no vendor check override (intel)"
    fi
    # gmx itself may not start here if GMX_SIMD is not supported by the build host
    /opt/gmx/bin/gmx --version 2>&1 | grep -E "GROMACS version|SIMD instructions|Plumed support" || true

%help
    GROMACS (Kubar DFTB+ QM/MM, one-rank OpenMP) + DFTB+ + PLUMED on Intel MKL.
    cat /opt/build_config.txt shows the CPU vendor and SIMD the image was built for.

        apptainer exec -B /data --env LD_PRELOAD= image.sif \
            gmx mdrun -deffnm md -ntomp 8 -pin on [-pinoffset ... -pinstride ...] [-plumed plumed.dat]

    In dftb_in.hsd, Solver = DivideAndConquer {} is the fastest eigensolver with MKL.
    mdrun reports at startup: the MKL version, its thread count, and whether MKL takes the
    Intel code paths (mkl_serv_intel_cpu_true() = 1).
